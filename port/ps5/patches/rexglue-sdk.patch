diff --git a/src/core/fiber_ps5.cpp b/src/core/fiber_ps5.cpp
new file mode 100644
index 0000000..3df588c
--- /dev/null
+++ b/src/core/fiber_ps5.cpp
@@ -0,0 +1,122 @@
+/**
+ * @file        rex/core/fiber_ps5.cpp
+ * @brief       PS5 backend for rex::thread::Fiber
+ *
+ * The console's getcontext writes more than the payload SDK's ucontext_t holds
+ * (928 bytes in the headers): into a Fiber on the heap it ran over the next
+ * chunk's header, on every guest thread. So the switch is done by hand, as on
+ * Android: the registers the System V ABI obliges a call to preserve (rbx, rbp,
+ * r12-r15, with MXCSR and the x87 control word) go onto the running stack, the
+ * stack pointer is stored in the fiber being left, and the target's stack
+ * pointer is loaded and its registers popped. A new fiber's stack starts with
+ * such a frame that returns to Trampoline.
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_PS5
+
+#include <rex/thread/fiber.h>
+
+#include <cassert>
+#include <cstdlib>
+#include <cstring>
+
+// void rex_fiber_switch(void** save_sp, void* load_sp)
+extern "C" void rex_fiber_switch(void** save_sp, void* load_sp);
+asm(R"(
+    .text
+    .p2align 4
+    .globl rex_fiber_switch
+    .hidden rex_fiber_switch
+    .type rex_fiber_switch, @function
+rex_fiber_switch:
+    pushq %rbp
+    pushq %rbx
+    pushq %r12
+    pushq %r13
+    pushq %r14
+    pushq %r15
+    subq  $8, %rsp
+    fnstcw (%rsp)
+    stmxcsr 4(%rsp)
+    movq  %rsp, (%rdi)
+    movq  %rsi, %rsp
+    fldcw (%rsp)
+    ldmxcsr 4(%rsp)
+    addq  $8, %rsp
+    popq  %r15
+    popq  %r14
+    popq  %r13
+    popq  %r12
+    popq  %rbx
+    popq  %rbp
+    ret
+    .size rex_fiber_switch, .-rex_fiber_switch
+)");
+
+namespace rex::thread {
+
+namespace {
+// The frame above: control words, six registers, the return address.
+constexpr size_t kFrameBytes = 64;
+constexpr size_t kReturnOffset = 56;
+}  // namespace
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  // sp_ is filled in by the first switch away from this thread.
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+
+  // Trampoline is entered by ret: rsp + 8 has to be 16-byte aligned, as after a call.
+  auto top = reinterpret_cast<uintptr_t>(f->stack_.data() + f->stack_.size()) & ~uintptr_t(15);
+  auto* frame = reinterpret_cast<uint8_t*>(top - 8 - 16 - kFrameBytes);
+  std::memset(frame, 0, kFrameBytes);
+  // The thread's own rounding and exception masks, not zeros.
+  uint16_t control_word = 0;
+  uint32_t mxcsr = 0;
+  __asm__ volatile("fnstcw %0\n\tstmxcsr %1" : "=m"(control_word), "=m"(mxcsr));
+  std::memcpy(frame, &control_word, sizeof(control_word));
+  std::memcpy(frame + 4, &mxcsr, sizeof(mxcsr));
+  const auto start = reinterpret_cast<uintptr_t>(&Fiber::Trampoline);
+  std::memcpy(frame + kReturnOffset, &start, sizeof(start));
+  f->sp_ = frame;
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  // tls_current_ was updated by SwitchTo before the switch landed here.
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+  // A fiber's entry never returns, and there is no frame below this one.
+  std::abort();
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_fiber_switch(&from->sp_, target->sp_);
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    tls_current_ = nullptr;
+  } else {
+    assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  }
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#endif  // REX_PLATFORM_PS5

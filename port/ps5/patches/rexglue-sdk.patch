+  ps5_shm virtual_memory{};
+  ps5_shm physical_memory{};
+  rc = ps5_shm_create(kVirtualBytes, &virtual_memory);
+  if (rc == 0) {
+    rc = ps5_shm_create(kPhysicalBytes, &physical_memory);
+  }
